{
  "info": {
    "_postman_id": "3b7a2f10-6b8d-4f2a-9c1e-7d5a0b9e4f21",
    "name": "health-guard-rwanda-midterm",
    "description": "One request per requirement for HealthGuard Rwanda (.NET API). Set the collection variables from /all responses before running requirement requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "SEED",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/seed/load",
          "host": ["{{baseUrl}}"],
          "path": ["api", "seed", "load"]
        },
        "description": "Setup helper: loads categories, sectors, officers, citizens, enrollments and verifications."
      },
      "response": []
    },
    {
      "name": "A2",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ubudehe 5\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/household-categories/save",
          "host": ["{{baseUrl}}"],
          "path": ["api", "household-categories", "save"]
        },
        "description": "A2 save. Copy the returned id into categoryId for the get/update/delete requests."
      },
      "response": []
    },
    {
      "name": "A2 - All",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/household-categories/all",
          "host": ["{{baseUrl}}"],
          "path": ["api", "household-categories", "all"]
        }
      },
      "response": []
    },
    {
      "name": "A2 - Get",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/household-categories/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "household-categories", "{{categoryId}}"]
        }
      },
      "response": []
    },
    {
      "name": "A2 - Update",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ubudehe 5 Updated\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/household-categories/update/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "household-categories", "update", "{{categoryId}}"]
        }
      },
      "response": []
    },
    {
      "name": "A2 - Delete",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/household-categories/delete/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "household-categories", "delete", "{{categoryId}}"]
        }
      },
      "response": []
    },
    {
      "name": "B1",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/citizens/by-village?village=nyagatovu",
          "host": ["{{baseUrl}}"],
          "path": ["api", "citizens", "by-village"],
          "query": [
            { "key": "village", "value": "nyagatovu" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "B2",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/enrollments/by-status?status=APPLIED",
          "host": ["{{baseUrl}}"],
          "path": ["api", "enrollments", "by-status"],
          "query": [
            { "key": "status", "value": "APPLIED" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "B3",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/enrollments/between?start=2026-10-01&end=2026-10-31",
          "host": ["{{baseUrl}}"],
          "path": ["api", "enrollments", "between"],
          "query": [
            { "key": "start", "value": "2026-10-01" },
            { "key": "end", "value": "2026-10-31" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "C1",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/enrollment-officers/by-household-category?name=ubudehe 1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "enrollment-officers", "by-household-category"],
          "query": [
            { "key": "name", "value": "ubudehe 1" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "C2",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/sectors/free",
          "host": ["{{baseUrl}}"],
          "path": ["api", "sectors", "free"]
        }
      },
      "response": []
    },
    {
      "name": "C3",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/household-categories/unused",
          "host": ["{{baseUrl}}"],
          "path": ["api", "household-categories", "unused"]
        }
      },
      "response": []
    },
    {
      "name": "C4",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/citizens/of-enrollment-officer/{{officerId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "citizens", "of-enrollment-officer", "{{officerId}}"]
        },
        "description": "Set officerId from GET /api/enrollment-officers/all. Use a random GUID to see the 404 case."
      },
      "response": []
    },
    {
      "name": "D1",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('futureDate', new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString().slice(0, 10));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enrollmentDate\": \"{{futureDate}}\",\n  \"status\": \"COVERED\",\n  \"coverageYear\": 2026,\n  \"premium\": 3000,\n  \"citizenId\": \"{{citizenId}}\",\n  \"enrollmentOfficerId\": \"{{officerId}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/enrollments/save",
          "host": ["{{baseUrl}}"],
          "path": ["api", "enrollments", "save"]
        },
        "description": "The COVERED status in the body must be forced to APPLIED. Change enrollmentDate to a past date for the 400 case."
      },
      "response": []
    },
    {
      "name": "D2",
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/api/enrollments/{{enrollmentId}}/status?status=PAYMENT_PENDING",
          "host": ["{{baseUrl}}"],
          "path": ["api", "enrollments", "{{enrollmentId}}", "status"],
          "query": [
            { "key": "status", "value": "PAYMENT_PENDING" }
          ]
        },
        "description": "Use an APPLIED enrollment id. Change status to COVERED to see the 400 illegal-transition case."
      },
      "response": []
    },
    {
      "name": "D2 - invalid flow",
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/api/enrollments/{{enrollmentId}}/status?status=COVERED",
          "host": ["{{baseUrl}}"],
          "path": ["api", "enrollments", "{{enrollmentId}}", "status"],
          "query": [
            { "key": "status", "value": "COVERED" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "D3",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/api/enrollment-officers/{{officerId}}/household-categories/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "enrollment-officers", "{{officerId}}", "household-categories", "{{categoryId}}"]
        }
      },
      "response": []
    },
    {
      "name": "D4",
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/api/enrollment-officers/{{officerId}}/sector?sectorNumber=4",
          "host": ["{{baseUrl}}"],
          "path": ["api", "enrollment-officers", "{{officerId}}", "sector"],
          "query": [
            { "key": "sectorNumber", "value": "4" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "E1",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"healthCenter\": \"Kimironko Health Center\",\n  \"remarks\": \"Coverage valid, consultation approved\",\n  \"dependents\": 3\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/coverage-verifications/save?enrollmentId={{coveredEnrollmentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "coverage-verifications", "save"],
          "query": [
            { "key": "enrollmentId", "value": "{{coveredEnrollmentId}}" }
          ]
        },
        "description": "Use a COVERED enrollment id. A non-COVERED id returns 400."
      },
      "response": []
    },
    {
      "name": "E2",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/coverage-verifications/citizen/{{nationalId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "coverage-verifications", "citizen", "{{nationalId}}"]
        }
      },
      "response": []
    },
    {
      "name": "E3",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/coverage-verifications/delete/{{verificationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "coverage-verifications", "delete", "{{verificationId}}"]
        },
        "description": "Copy an id from E2. Then retry DELETE /api/enrollments/delete/{{coveredEnrollmentId}} to see the 409 protection case."
      },
      "response": []
    },
    {
      "name": "E3 - protected enrollment",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/enrollments/delete/{{coveredEnrollmentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "enrollments", "delete", "{{coveredEnrollmentId}}"]
        }
      },
      "response": []
    },
    {
      "name": "F1",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/enrollments/stats/by-status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "enrollments", "stats", "by-status"]
        }
      },
      "response": []
    },
    {
      "name": "F2",
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/api/enrollments/cancel-day?enrollmentOfficerId={{officerId}}&date=2026-10-20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "enrollments", "cancel-day"],
          "query": [
            { "key": "enrollmentOfficerId", "value": "{{officerId}}" },
            { "key": "date", "value": "2026-10-20" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "BONUS-1",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/summary",
          "host": ["{{baseUrl}}"],
          "path": ["api", "dashboard", "summary"]
        }
      },
      "response": []
    },
    {
      "name": "BONUS-2",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/enrollments/page?page=0&size=5&sort=enrollmentDate,desc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "enrollments", "page"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "5" },
            { "key": "sort", "value": "enrollmentDate,desc" }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5080" },
    { "key": "categoryId", "value": "" },
    { "key": "officerId", "value": "" },
    { "key": "citizenId", "value": "" },
    { "key": "enrollmentId", "value": "" },
    { "key": "coveredEnrollmentId", "value": "" },
    { "key": "verificationId", "value": "" },
    { "key": "nationalId", "value": "1198880123456789" }
  ]
}
